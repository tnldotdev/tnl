{
  "ignorePatterns": [
    "internal/publisher/toolbar/toolbar.js",
    "internal/publisher/browserapi/model.gen.ts",
    "packages/ts/src/internal/management/client/**",
    "packages/ts/src/internal/management/core/**"
  ],
  "overrides": [
    {
      "files": ["packages/ts/src/internal/management/zod.gen.ts"],
      "rules": { "no-useless-escape": "off" }
    }
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "minimumDescriptionLength": 10
      }
    ]
  }
}
