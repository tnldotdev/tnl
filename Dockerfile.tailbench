FROM golang:1.27-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOFLAGS=-tags=ts_omit_ssh go build -trimpath -o /tailbench ./internal/tailtransport/cmd/tailbench

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /tailbench /tailbench
ENTRYPOINT ["/tailbench"]
CMD ["agent"]
