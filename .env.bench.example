# Benchmark selection and non-secret resource settings.
BENCH_SUITE=smoke
BENCH_FLY_ORG=tnl
BENCH_PARENT_DOMAIN=
BENCH_PARENT_ZONE_ID=
BENCH_ACME_EMAIL=

# Dedicated least-privilege Route 53 credentials. Leave the session token
# empty for long-lived IAM credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# BENCH_APPROVED is intentionally omitted and must be set for each paid run.
