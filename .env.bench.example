# Set these when invoking the benchmark tasks; local .env.bench files are not
# loaded automatically. Use a saved login for the approved server.
BENCH_SERVER=
BENCH_TRANSPORT=mixed
BENCH_VISITOR_NETWORK=tcp
# BENCH_VISITOR_INTERFACE=en0
BENCH_PUBLIC_URLS=4
BENCH_FRESH_CONNECTIONS_PER_SECOND=16
BENCH_HELD_STREAMS=4
BENCH_DURATION=10s

# Specify BENCH_SUITE=smoke (or target) and BENCH_APPROVED=1 per approved run.
