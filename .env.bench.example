# Optional staging workload defaults. The runner uses the saved staging login
# from `tnl login --server=https://control.tnl.wtf`.
BENCH_SERVER=https://control.tnl.wtf
BENCH_PUBLIC_URLS=4
BENCH_FRESH_CONNECTIONS_PER_SECOND=16
BENCH_HELD_STREAMS=4
BENCH_DURATION=10s

# Specify BENCH_SUITE=smoke (or target) and BENCH_APPROVED=1 per approved run.
