{
  "name": "@tnldotdev/tnl",
  "version": "0.0.0-development",
  "description": "The tnl client and framework integrations for project-local development.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnldotdev/tnl.git",
    "directory": "packages/tnl"
  },
  "bin": {
    "tnl": "dist/bin/tnl.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsc --project tsconfig.json",
    "clean": "node ../../scripts/clean-package.ts",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  },
  "peerDependencies": {
    "next": ">=16.3.4",
    "vite": ">=6.0.9"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
