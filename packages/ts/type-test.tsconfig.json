{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"]
