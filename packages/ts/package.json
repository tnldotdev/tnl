{
  "name": "@tnldotdev/tnl",
  "version": "0.0.0-development",
  "description": "public urls for collaborative dev.",
  "keywords": [
    "git-worktree",
    "local-development",
    "localhost",
    "nextjs",
    "ngrok-alternative",
    "self-hosted",
    "tunnel",
    "vite"
  ],
  "homepage": "https://tnl.dev",
  "bugs": {
    "url": "https://github.com/tnldotdev/tnl/issues"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnldotdev/tnl.git",
    "directory": "packages/ts"
  },
  "bin": {
    "tnl": "dist/bin/tnl.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "import": "./dist/index.browser.js",
        "require": "./dist/index.browser.cjs",
        "default": "./dist/index.browser.js"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./workload": {
      "types": "./dist/workload.d.ts",
      "node": {
        "import": "./dist/workload.js",
        "require": "./dist/workload.cjs"
      }
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsc --project tsconfig.json && node ../../scripts/build-ts-bridges.ts && node ../../scripts/node-licenses.ts",
    "clean": "node ../../scripts/clean-package.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@vercel/oidc": "4.0.2",
    "undici": "7.30.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "@types/bun": "1.4.2",
    "hono": "4.13.12",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.3"
  },
  "peerDependencies": {
    "next": ">=16.3.4",
    "vite": ">=6.0.9"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
