{
  "name": "@tnldotdev/tnl",
  "version": "1.0.0-development",
  "description": "take a shortcut through the internet.",
  "keywords": [
    "git-worktree",
    "local-development",
    "localhost",
    "nextjs",
    "ngrok-alternative",
    "self-hosted",
    "tunnel",
    "vite"
  ],
  "homepage": "https://tnl.dev",
  "bugs": {
    "url": "https://github.com/tnldotdev/tnl/issues"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnldotdev/tnl.git",
    "directory": "packages/ts"
  },
  "bin": {
    "tnl": "dist/bin/tnl.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/wasm/wasm_exec.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./adapters/node-postgres": {
      "types": "./dist/adapters/node-postgres.d.ts",
      "default": "./dist/adapters/node-postgres.js"
    },
    "./adapters/postgres-js": {
      "types": "./dist/adapters/postgres-js.d.ts",
      "default": "./dist/adapters/postgres-js.js"
    },
    "./adapters/ioredis": {
      "types": "./dist/adapters/ioredis.d.ts",
      "default": "./dist/adapters/ioredis.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./control": {
      "types": "./dist/control.d.ts",
      "default": "./dist/control.js"
    },
    "./workload": {
      "types": "./dist/workload.d.ts",
      "node": {
        "import": "./dist/workload.js",
        "require": "./dist/workload.js"
      }
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsc --build tsconfig.management.json --force && tsc --project tsconfig.json && node ../../scripts/build/sdk-wasm.ts && node ../../scripts/package/node-licenses.ts",
    "clean": "node --input-type=module -e 'import {rmSync} from \"node:fs\"; rmSync(\"dist\", {recursive:true, force:true})'",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@vercel/oidc": "4.0.2",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/pg": "8.23.1",
    "hono": "4.13.16",
    "ioredis": "5.11.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "ioredis": "^5.11.1",
    "next": ">=16.4.5",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "vite": ">=6.0.9"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
