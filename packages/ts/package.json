{
  "name": "@tnldotdev/tnl",
  "version": "1.0.0-development",
  "description": "take a shortcut through the internet.",
  "keywords": [
    "git-worktree",
    "local-development",
    "localhost",
    "nextjs",
    "ngrok-alternative",
    "self-hosted",
    "tunnel",
    "vite"
  ],
  "homepage": "https://tnl.dev",
  "bugs": {
    "url": "https://github.com/tnldotdev/tnl/issues"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnldotdev/tnl.git",
    "directory": "packages/ts"
  },
  "bin": {
    "tnl": "dist/bin/tnl.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/wasm/wasm_exec.js"
  ],
  "exports": {
    ".": {
      "workerd": {
        "types": "./dist/index.worker.d.ts",
        "default": "./dist/index.worker.js"
      },
      "worker": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.js",
        "require": "./dist/index.browser.js",
        "default": "./dist/index.browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./durable-object": {
      "workerd": {
        "types": "./dist/durable-object.worker.d.ts",
        "default": "./dist/durable-object.worker.js"
      },
      "types": "./dist/durable-object.d.ts",
      "import": "./dist/durable-object.js",
      "default": "./dist/durable-object.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./workload": {
      "types": "./dist/workload.d.ts",
      "node": {
        "import": "./dist/workload.js",
        "require": "./dist/workload.js"
      }
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsc --build tsconfig.management.json --force && tsc --project tsconfig.json && node ../../scripts/build/sdk-wasm.ts && node ../../scripts/package/node-licenses.ts",
    "clean": "node --input-type=module -e 'import {rmSync} from \"node:fs\"; rmSync(\"dist\", {recursive:true, force:true})'",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@vercel/oidc": "4.0.2",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "hono": "4.13.16",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "next": ">=16.4.5",
    "vite": ">=6.0.9"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
