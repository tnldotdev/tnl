{
  "name": "@tnldotdev/dev",
  "version": "0.1.0-rc.1",
  "description": "Support package for the official tnl framework integrations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnldotdev/tnl.git",
    "directory": "packages/dev"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsc --project tsconfig.json",
    "clean": "node ../../scripts/clean-package.mjs",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=20.9"
  }
}
