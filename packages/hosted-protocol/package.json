{
  "name": "@tnl/hosted-protocol",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "pnpm run \"/^generate:.+$/\"",
    "generate:core": "openapi-typescript ../../api/core/v1/openapi.yaml -o src/generated/core-v1.gen.ts",
    "generate:hosted": "openapi-typescript ../../api/hosted/v1/openapi.yaml -o src/generated/hosted-v1.gen.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "tr46": "6.0.0"
  }
}
