FROM --platform=$BUILDPLATFORM mirror.gcr.io/library/golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -mod=readonly -trimpath -o /out/tnl ./cmd/tnl

FROM mirror.gcr.io/library/node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9
COPY --from=build /out/tnl /usr/local/bin/tnl
COPY LICENSE NOTICE THIRD_PARTY_LICENSES.txt /licenses/tnl/
RUN install -d -o 1000 -g 1000 -m 0700 /state
USER 1000:1000
ENV TNL_STATE_DIR=/state
WORKDIR /
ENTRYPOINT ["/usr/local/bin/tnl"]
