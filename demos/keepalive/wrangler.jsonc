{
  "name": "tnl-keepalive",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "migrations": [
    { "tag": "admission-v1", "new_sqlite_classes": ["AdmissionCoordinator"] },
    { "tag": "local-turns-v2", "deleted_classes": ["AdmissionCoordinator"] },
  ],
  "routes": [
    { "pattern": "keepthisalive.com", "custom_domain": true },
    { "pattern": "start.keepthisalive.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "dist/site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "vars": {
    "SITE_ORIGIN": "https://keepthisalive.com",
    "START_HOST": "start.keepthisalive.com",
    "CONTROL_URL": "https://control.tnl.dev",
    "TEAM_ID": "tm_BPjU3E13GNmrwrIFqPA9sF",
    "PROJECT_KEY": "project-4f913a3d642157c67aba9a09bb376e5529dd1bafe419aba2",
    "DEPLOYMENT_ID": "dpl_ZY3m4AAcKrI7GjCl5BtKPk",
  },
}
