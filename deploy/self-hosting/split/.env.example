TNL_IMAGE=ghcr.io/madebyentropy/tnl@sha256:replace-with-published-image-digest
TNL_CONTROL_BIND=127.0.0.1
TNL_CONTROL_HOSTNAME=control.example.com
# set the source CIDRs control actually sees from your HTTPS edge.
TNLD_CONTROL_TRUSTED_PROXIES=replace-with-https-edge-peer-cidrs
TNLD_CONTROL_PROXY_PROVIDER=single-xff
TNL_INGRESS_BIND=192.0.2.11
TNL_INGRESS_B_BIND=192.0.2.14
TNL_RELAY_A_BIND=192.0.2.12
TNL_RELAY_B_BIND=192.0.2.13
TNL_SERVER_ZONE_ID=replace-with-server-domain-route53-zone-id

TNLD_DATABASE_DIRECT_URL=postgresql://tnl_migrate:replace@database.example.com/tnl?sslmode=require
TNLD_SERVER_DOMAIN=example.com
TNL_CONTROL_ENV_FILE=./control.env
TNL_RELAY_SLOTS_FILE=./relay-slots.json
# Generate four distinct secrets. Put each relay's token in its inventory entry, too.
TNL_INGRESS_CONTROL_CREDENTIAL=
TNL_FORWARDING_CREDENTIAL=
TNL_RELAY_A_CREDENTIAL=
TNL_RELAY_B_CREDENTIAL=
TNL_PRIVATE_CONTROL_CERTIFICATE_FILE=./certs/control.crt
TNL_PRIVATE_CONTROL_KEY_FILE=./certs/control.key
TNL_CLUSTER_CA_FILE=./certs/cluster-ca.pem
