TNL_IMAGE=ghcr.io/tnldotdev/tnl@sha256:replace-with-published-image-digest
TNL_PUBLIC_BIND=0.0.0.0
TNL_CONTROL_BIND=192.0.2.10
TNL_CONTROL_HOSTNAME=control.example.com
TNL_INGRESS_BIND=192.0.2.11
TNL_RELAY_A_BIND=192.0.2.12
TNL_RELAY_B_BIND=192.0.2.13
TNL_SERVER_ZONE_ID=replace-with-server-domain-route53-zone-id

TNLD_DATABASE_URL=postgresql://tnl_runtime:replace@pool.example.com/tnl?sslmode=require
TNLD_DATABASE_DIRECT_URL=postgresql://tnl_migrate:replace@database.example.com/tnl?sslmode=require
TNLD_SERVER_DOMAIN=example.com
TNLD_MANAGED_DEPLOYMENT_DOMAIN=routes.example.com
TNLD_LOGIN_TOKEN=replace-with-output-of-tnld-login-token
TNLD_STORAGE_KEY=replace-with-unpadded-base64url-32-byte-key
# TNLD_STORAGE_KEY_PREVIOUS=previous-unpadded-base64url-32-byte-key-during-rotation
TNLD_ACCESS_TOKEN_LIFETIME=1h
TNLD_REFRESH_TOKEN_LIFETIME=720h

# Required by control, ingress, and relays in a split deployment.
# Omit it in standalone mode; standalone components communicate in process.
TNLD_CLUSTER_SECRET=replace-with-high-entropy-cluster-secret
# TNLD_CLUSTER_SECRET_PREVIOUS=previous-cluster-secret-during-rotation

# TNLD_OIDC_ISSUER=https://accounts.example.com
# TNLD_OIDC_CLIENT_ID=tnl-cli
# TNLD_OIDC_LOGIN_FLOW=authorization_code_pkce
# TNLD_OIDC_SCOPES=openid,profile,email

# To delegate authorization to an external authority, set both values below,
# configure TNLD_OIDC_* above, and omit TNLD_LOGIN_TOKEN.
# TNLD_AUTHORITY_ENDPOINT=https://authority.example
# TNLD_HOSTED_SECRET=replace-with-high-entropy-hosted-secret
# TNLD_HOSTED_SECRET_PREVIOUS=previous-hosted-secret-during-rotation

TNLD_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
TNLD_ACME_EMAIL=operator@example.com
TNLD_ACME_ACCEPT_TERMS=true
TNLD_ACME_PROFILE=tlsserver

# Optional managed public-route DNS automation.
# TNLD_ROUTE53_MANAGED_ZONE_ID=replace-with-managed-domain-route53-zone-id
# TNLD_INGRESS_IPV4_ADDRESSES=192.0.2.11
# TNLD_INGRESS_IPV6_ADDRESSES=2001:db8::11

# Configure both values to deliver route usage reports.
# TNLD_ROUTE_USAGE_URL=https://usage.example.com
# TNLD_ROUTE_USAGE_TOKEN=tnl_service_replace
