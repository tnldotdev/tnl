TNL_IMAGE=ghcr.io/tnldotdev/tnl@sha256:replace-with-published-image-digest
TNL_PUBLIC_BIND=0.0.0.0
TNL_STATE_VOLUME=tnl_tnld-state

# TNLD_BACKUP_URL=s3://bucket/tnld
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

TNLD_DOMAIN=example.com
TNLD_RELAY_PROVIDER=tailcat
TNLD_ACCESS_TOKEN_LIFETIME=1h
TNLD_REFRESH_TOKEN_LIFETIME=720h

# TNLD_OIDC_ISSUER=https://accounts.example.com
# TNLD_OIDC_CLIENT_ID=tnl-cli
# TNLD_OIDC_LOGIN_FLOW=authorization_code_pkce

# Set all five values to delegate hostname authorization to an external authority.
# TNLD_AUTHORIZATION_AUTHORITY_ENDPOINT=https://authority.example
# TNLD_AUTHORIZATION_ISSUER=https://authority.example
# TNLD_AUTHORIZATION_RECEIVER=https://tnl.example.com
# TNLD_AUTHORIZATION_KEY_ID=authority-2026-09
# TNLD_AUTHORIZATION_PUBLIC_KEY=unpadded-base64url-ed25519-public-key

TNLD_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
TNLD_ACME_EMAIL=operator@example.com
TNLD_ACME_ACCEPT_TERMS=true
TNLD_ACME_PROFILE=tlsserver
