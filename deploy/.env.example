TNL_IMAGE=ghcr.io/0xcadams/tnl@sha256:replace-with-published-image-digest
TNL_PUBLIC_BIND=0.0.0.0
TNL_STATE_VOLUME=tnl_tnld-state

TNLD_CONTROL_HOSTNAME=core.example.com
TNLD_ROUTE_SUFFIX=apps.example.com
TNLD_BOOTSTRAP_TOKEN=replace-with-output-of-tnl-token-bootstrap
TNLD_RELAY_PROFILE=default

TNLD_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
TNLD_ACME_EMAIL=operator@example.com
TNLD_ACME_ACCEPT_TERMS=true
TNLD_ACME_PROFILE=tlsserver
