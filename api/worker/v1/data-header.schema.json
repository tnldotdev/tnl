{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tnl.dev/schemas/worker/v1/data-header.json",
  "title": "tnl worker data stream header v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["route_id", "route_version"],
  "properties": {
    "route_id": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "route_version": {"type": "integer", "description": "Route version receiving the data stream.", "minimum": 1}
  }
}
