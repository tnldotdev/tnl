{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tnl.dev/schemas/worker/v1/control.json",
  "title": "tnl worker control message v1",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/helloAccepted" },
    { "$ref": "#/$defs/attachRoute" },
    { "$ref": "#/$defs/routeReady" },
    { "$ref": "#/$defs/detachRoute" },
    { "$ref": "#/$defs/routeDrained" },
    { "$ref": "#/$defs/workerDraining" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "route_version"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" },
        "route_version": {
          "type": "integer",
          "description": "Route version assigned to the worker.",
          "minimum": 1
        }
      }
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "route_capacity"],
      "properties": {
        "type": { "const": "hello" },
        "route_capacity": {
          "type": "integer",
          "description": "Maximum number of routes the worker can serve concurrently.",
          "minimum": 1
        }
      }
    },
    "helloAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "hello_accepted" } }
    },
    "attachRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "route", "publisher_transport", "tailcat_dialer_private_key"],
      "properties": {
        "type": { "const": "attach_route" },
        "route": { "$ref": "#/$defs/route" },
        "publisher_transport": {
          "$ref": "../../transport/v1/tailcat-descriptor.schema.json",
          "description": "Tailcat transport advertised by the route publisher."
        },
        "tailcat_dialer_private_key": {
          "type": "string",
          "description": "Private node key used by the worker to dial the publisher transport.",
          "minLength": 1
        }
      }
    },
    "routeReady": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "route"],
      "properties": {
        "type": { "const": "route_ready" },
        "route": { "$ref": "#/$defs/route" }
      }
    },
    "detachRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "route"],
      "properties": {
        "type": { "const": "detach_route" },
        "route": { "$ref": "#/$defs/route" }
      }
    },
    "routeDrained": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "route"],
      "properties": {
        "type": { "const": "route_drained" },
        "route": { "$ref": "#/$defs/route" }
      }
    },
    "workerDraining": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "worker_draining" } }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code"],
      "properties": {
        "type": { "const": "error" },
        "route": { "$ref": "#/$defs/route" },
        "code": {
          "enum": ["invalid_message", "stale_route_version", "route_capacity_exceeded", "internal"]
        }
      }
    }
  }
}
