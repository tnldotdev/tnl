{
  "protocol_versions": [1],
  "authentication": {
    "required": true,
    "methods": ["login_token"]
  },
  "administration": {
    "version": 1,
    "operations": ["server_status", "routes", "hostnames", "credentials", "control_sessions", "maintenance_controls"]
  },
  "hostname_authorization": ["local_hostnames"],
  "hostname_suffix": "example",
  "temporary_name_support": true,
  "persistent_base_support": true,
  "custom_domain_support": true,
  "maximum_subdomain_depth": 8,
  "dns_ready": true,
  "ingress_ipv4": ["192.0.2.1"],
  "ingress_ipv6": ["2001:db8::1"],
  "local_hostnames": {
    "suffix": "example"
  },
  "transport": {
    "type": "tailcat",
    "version": 1,
    "relay_region": "default"
  },
  "acme": {
    "acme_profile": "tlsserver"
  }
}
