{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tnl.dev/schemas/transport/v1/tailcat-descriptor.json",
  "title": "Tailcat descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "publisher_public_key", "relay_region"],
  "properties": {
    "version": {
      "const": 1
    },
    "publisher_public_key": {
      "type": "string",
      "pattern": "^nodekey:[0-9a-f]{64}$"
    },
    "relay_region": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    }
  }
}
