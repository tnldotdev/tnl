{
  "name": "tnl-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @tnldotdev/tnl build",
    "clean": "pnpm --recursive --if-present run clean",
    "format": "oxfmt --write '**/*'",
    "format:check": "oxfmt --check '**/*'",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives connect/src connect/test connect/scripts demos/keepalive internal/client/project/loader.ts internal/publisher/toolbar internal/publisher/browserapi packages scripts vitest*.ts",
    "test": "pnpm build && pnpm test:run",
    "test:run": "vitest run",
    "test:coverage": "pnpm build && vitest run --coverage --mode coverage",
    "typecheck": "pnpm build && pnpm typecheck:run",
    "typecheck:run": "vitest run --config vitest.types.config.ts && tsc --project internal/publisher/toolbar/tsconfig.json && tsc --project demos/keepalive/tsconfig.json && tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.5",
    "@floating-ui/dom": "1.8.0",
    "@medv/finder": "4.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@tanstack/react-query": "5.106.1",
    "@testing-library/preact": "3.2.6",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "json-schema-to-typescript": "16.0.0",
    "kysely": "0.29.9",
    "mysql2": "3.24.6",
    "openapi-types": "12.1.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "pg": "8.23.1",
    "playwright": "1.65.0",
    "postgres": "3.4.9",
    "preact": "11.1.1",
    "react": "19.3.1",
    "semver": "7.8.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "workerd": "1.20261104.1",
    "ws": "8.22.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.18.0"
}
