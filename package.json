{
  "name": "tnl-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @tnldotdev/tnl build",
    "clean": "pnpm --recursive --if-present run clean",
    "format": "oxfmt --write '**/*'",
    "format:check": "oxfmt --check '**/*'",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives connect/src connect/test connect/scripts internal/client/project/loader.ts internal/publisher/toolbar internal/publisher/browserapi packages scripts vitest*.ts",
    "pack": "node scripts/package/verify-packages.ts",
    "test": "pnpm build && pnpm test:run",
    "test:run": "vitest run",
    "test:coverage": "pnpm build && vitest run --coverage --mode coverage",
    "typecheck": "pnpm build && pnpm typecheck:run",
    "typecheck:run": "tsc --project packages/ts/type-test.tsconfig.json && tsc --project packages/ts/augmented-type-test.tsconfig.json && tsc --project internal/publisher/toolbar/tsconfig.json && tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "15.5.2",
    "@floating-ui/dom": "1.8.0",
    "@medv/finder": "4.0.2",
    "@tanstack/react-query": "5.104.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "30.0.0",
    "@types/mysql": "2.15.28",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "mysql": "2.18.1",
    "mysql2": "3.24.6",
    "openapi-types": "12.1.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "pg": "8.23.1",
    "playwright": "1.64.0",
    "postgres": "3.4.9",
    "preact": "11.0.1",
    "react": "19.3.0",
    "typed-openapi": "4.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.28.7"
}
