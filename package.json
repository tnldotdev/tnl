{
  "name": "tnl-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @tnldotdev/tnl build",
    "clean": "pnpm --recursive --if-present run clean",
    "format": "oxfmt --write '**/*'",
    "format:check": "oxfmt --check '**/*'",
    "lint": "oxlint --deny-warnings internal/projectconfig/loader.mjs packages scripts vitest.config.ts",
    "pack": "node scripts/verify-packages.mjs",
    "pretest": "pnpm build",
    "pretypecheck": "pnpm build",
    "test": "vitest run && node --test packages/tnl/launcher.test.mjs",
    "test:ci": "vitest run && node --test packages/tnl/launcher.test.mjs",
    "test:coverage": "pnpm build && TNL_TEST_COVERAGE=1 vitest run --coverage",
    "typecheck": "tsc --project packages/tnl/type-test.tsconfig.json && tsc --project packages/tnl/augmented-type-test.tsconfig.json && tsc --project tsconfig.test.json",
    "typecheck:ci": "tsc --project packages/tnl/type-test.tsconfig.json && tsc --project packages/tnl/augmented-type-test.tsconfig.json && tsc --project tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.0",
    "json-schema-to-typescript": "16.0.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "ws": "8.21.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.25.0"
}
