{
  "name": "tnl-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @tnldotdev/tnl build",
    "clean": "pnpm --recursive --if-present run clean",
    "format": "oxfmt --write '**/*'",
    "format:check": "oxfmt --check '**/*'",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives internal/projectconfig/loader.ts internal/feedbacktoolbar internal/publisherapi packages scripts vitest*.ts",
    "pack": "node scripts/verify-packages.ts",
    "test": "pnpm build && pnpm test:run",
    "test:run": "vitest run",
    "test:coverage": "pnpm build && vitest run --coverage --mode coverage",
    "typecheck": "pnpm build && pnpm typecheck:run",
    "typecheck:run": "tsc --project packages/tnl/type-test.tsconfig.json && tsc --project packages/tnl/augmented-type-test.tsconfig.json && tsc --project internal/feedbacktoolbar/tsconfig.json && tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@floating-ui/dom": "1.8.0",
    "@medv/finder": "4.0.2",
    "@tanstack/react-query": "5.104.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "openapi-types": "12.1.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright": "1.63.0",
    "preact": "11.0.0",
    "react": "19.3.0",
    "typed-openapi": "4.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "ws": "8.21.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.25.0"
}
