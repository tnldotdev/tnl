{
  "name": "tnl-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @tnldotdev/tnl build",
    "clean": "pnpm --recursive --if-present run clean",
    "format": "oxfmt --write '**/*'",
    "format:check": "oxfmt --check '**/*'",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives internal/projectconfig/loader.ts packages scripts vitest.config.ts",
    "pack": "node scripts/verify-packages.ts",
    "test": "pnpm build && pnpm test:run",
    "test:run": "vitest run && node --test packages/tnl/launcher.test.ts",
    "test:coverage": "pnpm build && vitest run --coverage --mode coverage",
    "typecheck": "pnpm build && pnpm typecheck:run",
    "typecheck:run": "tsc --project packages/tnl/type-test.tsconfig.json && tsc --project packages/tnl/augmented-type-test.tsconfig.json && tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.1",
    "json-schema-to-typescript": "16.0.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.25.0"
}
